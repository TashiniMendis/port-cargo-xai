{
  "name": "port-cargo-xai",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --user uv && uv sync",
  "forwardPorts": [8000, 8501],
  "portsAttributes": {
    "8000": { "label": "API" },
    "8501": { "label": "Front end" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
